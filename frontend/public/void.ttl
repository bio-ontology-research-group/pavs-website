# VoID Description for PAVS Knowledge Graph
# Generated: 2026-03-14T08:26:50.670171Z
# Version: 1.1.0

<https://pavs.phenomebrowser.net/dataset>
    a void:Dataset , dcat:Dataset ;
    
    # Basic descriptive metadata
    dct:title "Phenotype-Associated Variants in Saudi Arabia (PAVS)" ;
    dct:description """PAVS is a curated knowledge graph of genomic variants and clinical phenotypes from Saudi Arabian patients with rare genetic diseases. The dataset integrates multiple clinical cohorts and links each case to international ontologies (HPO, OMIM, MONDO) and variant databases (ClinVar, dbSNP, TogoVar). Data is represented using GA4GH Phenopackets v2 standard and exposed as RDF for SPARQL querying.""" ;
    rdfs:label "PAVS Knowledge Graph" ;
    skos:prefLabel "Phenotype-Associated Variants in Saudi Arabia"@en ;
    skos:altLabel "PAVS"@en ;
    
    # Version and provenance
    dct:hasVersion "1.1.0" ;
    pav:version "1.1.0" ;
    pav:hasCurrentVersion <https://pavs.phenomebrowser.net/version/1.1.0> ;
    pav:createdOn "2026-03-14T08:26:50.670171Z"^^xsd:dateTime ;
    pav:lastUpdateOn "2026-03-14T08:26:50.670171Z"^^xsd:dateTime ;
    
    # Authors and contributors (using identifiers.org ORCID)
    dct:creator orcid:0000-0001-8149-5890 ;  # Robert Hoehndorf
    pav:authoredBy orcid:0000-0001-8149-5890 ;
    pav:createdBy orcid:0000-0001-8149-5890 ;
    pav:curatedBy orcid:0000-0001-6816-2119 ;  # Marwa Abdelhakim
