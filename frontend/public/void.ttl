    # SPARQL endpoint
    void:sparqlEndpoint <https://pavs.phenomebrowser.net/sparql> ;
    dcat:endpointURL <https://pavs.phenomebrowser.net/sparql> ;
    dcat:endpointDescription <https://pavs.phenomebrowser.net/api/docs> ;
    sd:endpoint <https://pavs.phenomebrowser.net/sparql> ;
    
    # License and rights (CC-BY 4.0)
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
