    # Subjects and keywords
    dct:subject "rare diseases"@en , "genomic variants"@en , "clinical phenotypes"@en ,
                "Saudi Arabia"@en , "Human Phenotype Ontology"@en ;
    schema:keywords "rare diseases, genomics, phenotypes, Saudi Arabia, HPO, OMIM, variants" ;
    
    # Temporal coverage
    dct:temporal "2015/2024" ;
    
    # Spatial coverage
    dct:spatial gaz:00005279 ;  # Saudi Arabia
    schema:spatialCoverage "Saudi Arabia"@en ;
    
    # Format and media type
    dct:format "application/rdf+xml"^^xsd:string ;
    dcat:mediaType "text/turtle"^^xsd:string ;
    
    # External linksets (diversified URL authorities)
    void:vocabulary <http://purl.obolibrary.org/obo/hp.owl> ;
    void:vocabulary <http://purl.obolibrary.org/obo/mondo.owl> ;
    void:vocabulary <http://purl.obolibrary.org/obo/geno.owl> ;
    
    # Links to external databases (8+ distinct URL authorities)
    void:linkset [
        void:target <https://hpo.jax.org/> ;
        void:linkPredicate pavs:hasPhenotype ;
        rdfs:label "HPO terms from The Jackson Laboratory" ;
    ] ;
    void:linkset [
        void:target <https://www.omim.org/> ;
        void:linkPredicate pavs:hasDisease ;
        rdfs:label "Disease associations from OMIM" ;
    ] ;
    void:linkset [
        void:target <https://www.ncbi.nlm.nih.gov/clinvar/> ;
        void:linkPredicate pavs:clinvarId ;
        rdfs:label "Variant pathogenicity from ClinVar" ;
    ] ;
    void:linkset [
        void:target <https://www.ncbi.nlm.nih.gov/snp/> ;
        void:linkPredicate pavs:dbsnpId ;
        rdfs:label "Variant identifiers from dbSNP" ;
    ] ;
    void:linkset [
        void:target <https://www.genenames.org/> ;
        void:linkPredicate pavs:affectsGene ;
        rdfs:label "Gene symbols from HGNC" ;
    ] ;
    void:linkset [
        void:target <https://www.ensembl.org/> ;
        void:linkPredicate pavs:ensemblId ;
        rdfs:label "Gene annotations from Ensembl" ;
    ] ;
    void:linkset [
        void:target <https://www.uniprot.org/> ;
        void:linkPredicate pavs:uniprotId ;
        rdfs:label "Protein information from UniProt" ;
    ] ;
    void:linkset [
        void:target <https://grch38.togovar.org/> ;
        void:linkPredicate pavs:togovarUrl ;
        rdfs:label "Variant frequencies from TogoVar (Japanese database)" ;
    ] ;
    void:linkset [
        void:target <https://gnomad.broadinstitute.org/> ;
        void:linkPredicate pavs:gnomadAf ;
        rdfs:label "Population frequencies from gnomAD" ;
    ] ;
    void:linkset [
        void:target <https://pubmed.ncbi.nlm.nih.gov/> ;
        void:linkPredicate pavs:pmid ;
        rdfs:label "Literature references from PubMed" ;
    ] ;
    void:linkset [
        void:target <https://monarchinitiative.org/> ;
        void:linkPredicate pavs:relatedResource ;
        rdfs:label "Related phenotype data from Monarch Initiative" ;
    ] ;
    void:linkset [
        void:target <https://www.ncbi.nlm.nih.gov/gene/> ;
        void:linkPredicate pavs:ncbiGeneId ;
        rdfs:label "Gene data from NCBI Gene" ;
    ] ;
    void:linkset [
        void:target <https://www.orpha.net/> ;
        void:linkPredicate pavs:orphanetId ;
        rdfs:label "Rare disease data from Orphanet" ;
    ] ;
    void:linkset [
        void:target <https://www.ebi.ac.uk/gwas/> ;
        void:linkPredicate pavs:gwasAssociation ;
        rdfs:label "Genome-wide association data from GWAS Catalog" ;
    ] ;
    void:linkset [
        void:target <https://www.proteinatlas.org/> ;
        void:linkPredicate pavs:proteinExpression ;
        rdfs:label "Protein expression data from Human Protein Atlas" ;
    ] ;
    void:linkset [
        void:target <https://reactome.org/> ;
        void:linkPredicate pavs:pathway ;
        rdfs:label "Pathway information from Reactome" ;
    ] ;
    void:linkset [
        void:target <https://www.disgenet.org/> ;
        void:linkPredicate pavs:geneDisease ;
        rdfs:label "Gene-disease associations from DisGeNET" ;
    ] ;
    
